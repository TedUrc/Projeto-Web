# ============================================
# 1. REGRAS DO BACK-END (Python)
# ============================================
back-end/venv/
back-end/.env
back-end/__pycache__/
back-end/*.pyc
back-end/*.swp

# ============================================
# 2. REGRAS DO FRONT-END (React / Node)
# ============================================
front-end web/node_modules/
front-end web/.env
front-end web/build/
front-end web/dist/
front-end web/dist-ssr/
front-end web/*.local
front-end web/*.log

# ============================================
# 3. LOGS (geral + React)
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# 4. ARQUIVOS DE EDITORES E IDE (VS Code, IntelliJ, etc.)
# ============================================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln

# ============================================
# 5. ARQUIVOS TEMPORÁRIOS GERAIS (Vim, swap, etc.)
# ============================================
*.swp
*.swo
*.sw?          # <--- Isso cobre *.swp, *.swo, *.swa, etc. (do .gitignore do React)
__pycache__/
*.pyc